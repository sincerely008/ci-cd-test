# Copy to .env for local Docker Compose use. Replace all example passwords first.
IMAGE=ci-cd-test:local
APP_PORT=8080
POSTGRES_DB=ci_cd_test
POSTGRES_USER=ci_cd_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_VOLUME_NAME=ci-cd-test-postgres-data
APP_SECURITY_USER=app-admin
APP_SECURITY_PASSWORD=replace-with-a-local-password
